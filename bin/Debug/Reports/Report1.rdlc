  <ReportParameters>
    <ReportParameter Name="ReportParameter1">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>Select Ordini.IDOrd, Ordini.IDCliOrd, Ordini.Mat,Ordini.QtaOrd,Ordini.PrezzoOrd,Ordini.ImportoOrd
From Ordini LEFT OUTER Join
                  Fattura On Ordini.IDOrd = Fattura.IDOrd
Where (Fattura.IDOrd Is NULL)</Value>
        </Values>
      </DefaultValue>
      <AllowBlank>true</AllowBlank>
